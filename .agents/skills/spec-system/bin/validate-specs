#!/bin/sh
# Runs the spec-validator release pinned in the project's .agents/spec-validator.lock: an installed
# spec-validator of exactly that version, else the release binary, downloaded once into the user
# cache and verified against the lock. SPEC_VALIDATOR=<path> runs another binary.
#
# Usage: validate-specs [validator arguments]
#        validate-specs --update [v<version>]   pin a release (default: the latest release) in the lock
# Environment: SPEC_VALIDATOR_SIGNERS  allowed_signers file for --update (default ~/.agents/allowed_signers)
#              SPEC_VALIDATOR_BASE_URL the validator's repository (default https://github.com/thst71/spec-validator)
set -eu

here=$(cd "$(dirname "$0")" && pwd)
lock=$(cd "$here/../../.." && pwd)/spec-validator.lock
base=${SPEC_VALIDATOR_BASE_URL:-https://github.com/thst71/spec-validator}

fail() {
	echo "validate-specs: $*" >&2
	exit 2
}

pinned() {
	awk '$1 == "version" { print $2 }' "$lock"
}

update() {
	tag=${1:-}
	signers=${SPEC_VALIDATOR_SIGNERS:-$HOME/.agents/allowed_signers}
	[ -f "$signers" ] ||
		fail "no allowed signers in $signers; add the line '<email> namespaces=\"git\" <ssh public key>' of the validator's maintainer"
	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	if [ -z "$tag" ]; then
		# The newest tag with a release: a tag can exist without one (failed or pending release).
		for candidate in $(git ls-remote --tags --refs "$base.git" 'v*' | sed 's#.*refs/tags/##' |
			grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -r -V); do
			if curl -fsSL -o "$work/checksums.txt" "$base/releases/download/$candidate/checksums.txt" 2>/dev/null; then
				tag=$candidate
				break
			fi
			rm -f "$work/checksums.txt"
			echo "validate-specs: skipping $candidate, it has no release" >&2
		done
		[ -n "$tag" ] || fail "no release found in $base"
	fi
	case $tag in
	v[0-9]*.[0-9]*.[0-9]*) ;;
	*) fail "usage: validate-specs --update [v<major>.<minor>.<patch>]" ;;
	esac
	version=${tag#v}

	git clone -q --depth 1 --no-checkout --branch "$tag" "$base.git" "$work/validator" 2>/dev/null ||
		fail "cannot clone $tag from $base.git"
	validator="$work/validator"
	[ "$(git -C "$validator" cat-file -t "refs/tags/$tag")" = tag ] || fail "$tag is not an annotated tag"
	output=$(git -C "$validator" -c gpg.ssh.program=ssh-keygen -c gpg.ssh.allowedSignersFile="$signers" \
		verify-tag "$tag" 2>&1) || fail "$tag is not signed by an allowed signer: $output"
	principal=$(printf '%s\n' "$output" | sed -n 's/^Good "git" signature for \(.*\) with .* key .*$/\1/p')
	tagger=$(git -C "$validator" for-each-ref --format='%(taggeremail:trim)' "refs/tags/$tag")
	[ "$principal" = "$tagger" ] || fail "$tag is signed by $principal but tagged by $tagger"

	[ -f "$work/checksums.txt" ] ||
		curl -fsSL -o "$work/checksums.txt" "$base/releases/download/$tag/checksums.txt" ||
		fail "cannot download the checksums of $tag"
	{
		echo "# spec-validator pin, written by: .agents/skills/spec-system/bin/validate-specs --update"
		echo "version $version"
		awk -v prefix="spec-validator_${version}_" \
			'index($2, prefix) == 1 && $2 ~ /\.(tar\.gz|zip)$/ { print $1 "  " $2 }' "$work/checksums.txt"
	} >"$work/lock"
	grep -q '^[0-9a-f]\{64\}  ' "$work/lock" || fail "the checksums of $tag list no archives"

	previous=none
	if [ -f "$lock" ]; then previous=$(pinned); fi
	mv "$work/lock" "$lock"
	git -C "$(dirname "$lock")" add "$lock" 2>/dev/null || true
	echo "pinned spec-validator $version (was $previous), signed by $principal; commit it as: chore: spec-validator $version"
}

if [ "${1:-}" = --update ]; then
	update "${2:-}"
	exit 0
fi

if [ -n "${SPEC_VALIDATOR:-}" ]; then
	exec "$SPEC_VALIDATOR" "$@"
fi

[ -f "$lock" ] || fail "no $lock; create it with: .agents/skills/spec-system/bin/validate-specs --update [v<version>]"
version=$(pinned)
[ -n "$version" ] || fail "no version line in $lock"

if command -v spec-validator >/dev/null 2>&1; then
	installed=$(spec-validator -version 2>/dev/null || true)
	if [ "${installed#v}" = "$version" ]; then
		exec spec-validator "$@"
	fi
fi

case $(uname -s) in
Darwin) os=darwin ;;
Linux) os=linux ;;
*) fail "unsupported system $(uname -s); on Windows use validate-specs.ps1" ;;
esac
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
*) fail "unsupported architecture $(uname -m)" ;;
esac

cache="${XDG_CACHE_HOME:-$HOME/.cache}/spec-validator/$version"
binary="$cache/spec-validator"

if [ ! -x "$binary" ]; then
	archive="spec-validator_${version}_${os}_${arch}.tar.gz"
	url="$base/releases/download/v$version/$archive"
	expected=$(awk -v name="$archive" '$2 == name { print $1 }' "$lock")
	[ -n "$expected" ] || fail "no checksum for $archive in $lock"

	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	if ! curl -fsSL -o "$work/$archive" "$url"; then
		if command -v go >/dev/null 2>&1; then
			echo "validate-specs: download failed, running from source with go" >&2
			rm -rf "$work"
			exec go run "github.com/thst71/spec-validator/cmd/spec-validator@v$version" "$@"
		fi
		fail "cannot download $url"
	fi
	if command -v sha256sum >/dev/null 2>&1; then
		actual=$(sha256sum "$work/$archive" | cut -d ' ' -f 1)
	else
		actual=$(shasum -a 256 "$work/$archive" | cut -d ' ' -f 1)
	fi
	[ "$actual" = "$expected" ] || fail "checksum mismatch for $archive"

	tar -xzf "$work/$archive" -C "$work" spec-validator
	mkdir -p "$cache"
	mv "$work/spec-validator" "$binary"
	rm -rf "$work"
	trap - EXIT
fi

exec "$binary" "$@"
